# ============================================================
# .env.example — Variables d'environnement pour l'app Streamlit
# NE PAS committer ce fichier avec de vraies valeurs !
# Copiez-le en .env et remplissez vos vraies valeurs.
# ============================================================

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=VOTRE_ACCOUNT          # ex: PNYBUFI-SS97192
SNOWFLAKE_USER=VOTRE_USER
SNOWFLAKE_PASSWORD=VOTRE_MOT_DE_PASSE
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=finance_db
SNOWFLAKE_WAREHOUSE=finance_dwh
SNOWFLAKE_SCHEMA=raw
SNOWFLAKE_MARTS_SCHEMA=MARTS

# --- Chemin des CSV (dans le conteneur Docker) ---
CSV_DIR=/app/data

# --- Airflow REST API (optionnel — laisser vide pour désactiver) ---
AIRFLOW_URL=http://airflow:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=dbt_snowflake_pipeline

# --- PostgreSQL Airflow (inchangé) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
