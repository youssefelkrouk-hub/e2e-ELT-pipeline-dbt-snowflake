# ============================================================
# .streamlit/secrets.toml.example
# NE PAS committer ce fichier avec de vraies valeurs !
# Copiez-le en secrets.toml et remplissez les valeurs.
# ============================================================

[snowflake]
account   = "VOTRE_ACCOUNT_SNOWFLAKE"      # ex: xyz12345.eu-west-1
user      = "VOTRE_USER"
password  = "VOTRE_MOT_DE_PASSE"
role      = "VOTRE_ROLE"
database  = "finance_db"
warehouse = "finance_dwh"
schema    = "MARTS"

# Airflow (optionnel)
[airflow]
url      = "http://localhost:8081"
user     = "admin"
password = "admin"
dag_id   = "dbt_snowflake_pipeline"
